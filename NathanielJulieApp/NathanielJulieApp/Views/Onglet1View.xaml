<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NathanielJulieApp.Views.Onglet1View"
             Title="Recherche">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="20">

            <Label
                Text="{Binding Titre}"
                FontSize="24"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center" />

            <Image
                Source="{Binding Image}"
                HeightRequest="250"
                Aspect="AspectFit"
                HorizontalOptions="Center" />

            <Label
                Text="{Binding Description}"
                FontSize="16"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
